# Local development secrets for `wrangler dev` (copy to `.dev.vars`, which is gitignored).
# In production these are set with `wrangler secret put <NAME>`.
#
# All keys are NUXT_-prefixed so useRuntimeConfig() picks them up under the
# cloudflare_module preset (see web/nuxt.config.ts runtimeConfig).

# Resend (https://resend.com) — transactional email for the feedback widget.
# The sending domain for NUXT_RESEND_FROM must be verified in Resend first.
NUXT_RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
NUXT_RESEND_FROM="Urban World Feedback <feedback@theurban.world>"
NUXT_FEEDBACK_TO_EMAIL="you@example.com"

# Cloudflare Turnstile — secret key is server-only; site key is public.
NUXT_TURNSTILE_SECRET_KEY="0x0000000000000000000000000000000000000000"
NUXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
